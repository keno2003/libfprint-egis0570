From 726555567e4e9ea0c81482ae05c1777c9a5aaa5a Mon Sep 17 00:00:00 2001
From: keno2003 <209372532+keno2003@users.noreply.github.com>
Date: Wed, 23 Sep 2026 12:12:20 +0200
Subject: [PATCH] egis0570: simplify touch capture and isolate matching work

---
 libfprint/drivers/egis0570touch-match.cpp |  60 +++--
 libfprint/drivers/egis0570touch-proto.h   |   5 +-
 libfprint/drivers/egis0570touch.c         | 262 ++++++++++++++--------
 tests/meson.build                         |   5 +
 tests/test-egis0570touch-driver.c         | 183 +++++++++++++++
 5 files changed, 397 insertions(+), 118 deletions(-)
 create mode 100644 tests/test-egis0570touch-driver.c

diff --git a/libfprint/drivers/egis0570touch-match.cpp b/libfprint/drivers/egis0570touch-match.cpp
index 2688348b..3468baca 100644
--- a/libfprint/drivers/egis0570touch-match.cpp
+++ b/libfprint/drivers/egis0570touch-match.cpp
@@ -1,8 +1,3 @@
-/* EXPERIMENTAL: adapted from smox/libfprint-elan-04f3-0c63, commit
- * 0f18837da8d691946673710d63a81b39d0782fca. Geometry adapted for Egis 0570.
- * The original ELAN measurements below do NOT validate these parameters
- * for Egis. Authentication thresholds require independent evaluation.
- */
 /*
  * Descriptor matching for the ELAN 04f3:0c63
  * Copyright (C) 2026 Michael Brunner
@@ -25,6 +20,8 @@
 #include <algorithm>
 #include <cstring>
 #include <cmath>
+#include <exception>
+#include <memory>
 #include <vector>
 
 namespace {
@@ -173,8 +170,8 @@ struct _Egis0570TouchFeatures
 
 Egis0570TouchFeatures *
 fpi_egis0570touch_features_extract (const uint16_t *frames,
-                           guint           frame_count,
-                           const uint16_t *background)
+                                  guint           frame_count,
+                                  const uint16_t *background) try
 {
   if (frames == nullptr || background == nullptr || frame_count == 0)
     return nullptr;
@@ -205,10 +202,15 @@ fpi_egis0570touch_features_extract (const uint16_t *frames,
   if (best_keypoints.empty ())
     return nullptr;
 
-  auto *features = new _Egis0570TouchFeatures;
+  auto features = std::make_unique<_Egis0570TouchFeatures> ();
   features->keypoints = std::move (best_keypoints);
   features->descriptors = std::move (best_descriptors);
-  return features;
+  return features.release ();
+}
+catch (const std::exception &)
+{
+  /* No C++ exception may escape into the C driver; NULL requests a retry. */
+  return nullptr;
 }
 
 guint
@@ -222,14 +224,14 @@ fpi_egis0570touch_features_keypoint_count (Egis0570TouchFeatures *features)
  *
  * Only the coordinates are kept from each keypoint; scale, angle and response
  * are not needed once the descriptor exists. Descriptors are stored as bytes:
- * OpenCV returns floats, but every value measured across the corpus was an
- * integer in 0..220, so this is lossless. Verified to give bit-identical
- * results at a quarter of the size, 17 KB per capture instead of 70 KB.
+ * SIFT descriptors are rounded and clamped to bytes. This is the existing
+ * version-1 format; changing it would require template migration.
  */
 GBytes *
-fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features)
+fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features) try
 {
-  if (features == nullptr || features->descriptors.cols != 128)
+  if (features == nullptr || features->keypoints.empty () ||
+      features->descriptors.cols != 128)
     return nullptr;
 
   const uint16_t count = static_cast<uint16_t> (
@@ -239,7 +241,7 @@ fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features)
                       static_cast<size_t> (count) * 2 * sizeof (float) +
                       static_cast<size_t> (count) * 128;
 
-  auto *buffer = static_cast<uint8_t *> (g_malloc (size));
+  g_autofree uint8_t *buffer = static_cast<uint8_t *> (g_malloc (size));
   size_t offset = 0;
 
   write_u32_le (buffer + offset, kBlobMagic); offset += 4;
@@ -263,11 +265,15 @@ fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features)
       offset += 128;
     }
 
-  return g_bytes_new_take (buffer, size);
+  return g_bytes_new_take (g_steal_pointer (&buffer), size);
+}
+catch (const std::exception &)
+{
+  return nullptr;
 }
 
 Egis0570TouchFeatures *
-fpi_egis0570touch_features_deserialise (GBytes *blob)
+fpi_egis0570touch_features_deserialise (GBytes *blob) try
 {
   if (blob == nullptr)
     return nullptr;
@@ -289,7 +295,7 @@ fpi_egis0570touch_features_deserialise (GBytes *blob)
   if (size != expected)
     return nullptr;
 
-  auto *features = new _Egis0570TouchFeatures;
+  auto features = std::make_unique<_Egis0570TouchFeatures> ();
   features->keypoints.reserve (count);
   features->descriptors = cv::Mat (count, 128, CV_32F);
 
@@ -304,10 +310,7 @@ fpi_egis0570touch_features_deserialise (GBytes *blob)
       if (!std::isfinite (xy[0]) || !std::isfinite (xy[1]) ||
           xy[0] < 0 || xy[1] < 0 ||
           xy[0] >= kWidth * kUpscale || xy[1] >= kHeight * kUpscale)
-        {
-          delete features;
-          return nullptr;
-        }
+        return nullptr;
       features->keypoints.emplace_back (cv::Point2f (xy[0], xy[1]), 1.0f);
     }
 
@@ -319,12 +322,16 @@ fpi_egis0570touch_features_deserialise (GBytes *blob)
       offset += 128;
     }
 
-  return features;
+  return features.release ();
+}
+catch (const std::exception &)
+{
+  return nullptr;
 }
 
 guint
 fpi_egis0570touch_features_compare (Egis0570TouchFeatures *probe,
-                           Egis0570TouchFeatures *gallery)
+                                  Egis0570TouchFeatures *gallery) try
 {
   if (probe == nullptr || gallery == nullptr)
     return 0;
@@ -363,6 +370,11 @@ fpi_egis0570touch_features_compare (Egis0570TouchFeatures *probe,
 
   return static_cast<guint> (cv::countNonZero (inliers));
 }
+catch (const std::exception &)
+{
+  /* A failed comparison must never authenticate. */
+  return 0;
+}
 
 void
 fpi_egis0570touch_features_free (Egis0570TouchFeatures *features)
