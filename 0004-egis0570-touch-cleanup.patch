         {
           self->present = FALSE;
           fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NONE);
-          process_press (dev);
-          self->frame_count = 0;
-          if (!self->finished)
-            fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+          return TRUE;
         }
     }
+  return FALSE;
 }
 
 static void
@@ -307,9 +351,8 @@ run_state (FpiSsm *ssm, FpDevice *dev)
       fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, receive_frames_cb, NULL);
       break;
     case PROCESS_FRAMES:
-      process_packet (dev);
-      if (self->finished)
-        fpi_ssm_mark_completed (ssm);
+      if (process_packet (dev))
+        fpi_ssm_next_state (ssm);
       else
         {
           self->initializing = FALSE;
@@ -317,6 +360,36 @@ run_state (FpiSsm *ssm, FpDevice *dev)
           fpi_ssm_jump_to_state (ssm, SEND_COMMAND);
         }
       break;
+    case MATCH_FRAMES:
+      {
+        MatchData *data = g_new0 (MatchData, 1);
+        g_autoptr(GTask) task = g_task_new (dev, fpi_device_get_cancellable (dev),
