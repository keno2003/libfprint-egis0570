  * Device data
  */
 
-#define EGIS0570_CONF 1
 #define EGIS0570_INTF 0
 
 /*
@@ -54,7 +53,7 @@
 
 #define EGIS0570_INIT_TOTAL (sizeof ((init_pkts)) / sizeof ((init_pkts[0])))
 
-static unsigned char init_pkts[][EGIS0570_PKTSIZE] = {
+static const unsigned char init_pkts[][EGIS0570_PKTSIZE] = {
 	{0x45, 0x47, 0x49, 0x53, 0x01, 0x10, 0x00},
 	{0x45, 0x47, 0x49, 0x53, 0x01, 0x11, 0x38},
 	{0x45, 0x47, 0x49, 0x53, 0x01, 0x12, 0x00},
@@ -109,7 +108,7 @@ static unsigned char init_pkts[][EGIS0570_PKTSIZE] = {
 
 #define EGIS0570_REPEAT_TOTAL (sizeof ((repeat_pkts)) / sizeof ((repeat_pkts[0])))
 
-static unsigned char repeat_pkts[][EGIS0570_PKTSIZE] =
+static const unsigned char repeat_pkts[][EGIS0570_PKTSIZE] =
 {
   { 0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x0f },
   { 0x45, 0x47, 0x49, 0x53, 0x00, 0x02, 0x0f },
diff --git a/libfprint/drivers/egis0570touch.c b/libfprint/drivers/egis0570touch.c
index 07cb40d9..0b6cf079 100644
--- a/libfprint/drivers/egis0570touch.c
+++ b/libfprint/drivers/egis0570touch.c
@@ -10,7 +10,10 @@
 
 #define FRAME_PIXELS (EGIS0570_IMGWIDTH * EGIS0570_IMGHEIGHT)
 #define MAX_FRAMES 50
+#define AUTH_FRAMES 10
 #define ENROLL_STAGES 12
+#define MIN_FEATURES 20
+#define RELEASE_FRAMES 5
 /* Provisional research threshold, not a measured false-accept guarantee. */
 #define MATCH_THRESHOLD 12
 
@@ -22,6 +25,7 @@ struct _FpDeviceEgis0570Touch
   gboolean initializing;
   gboolean calibrated;
   gboolean present;
+  gboolean wait_for_removal;
   guint absent_frames;
   guint frame_count;
   guint16 background[FRAME_PIXELS];
@@ -35,16 +39,32 @@ G_DECLARE_FINAL_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch,
                       FPI, DEVICE_EGIS0570TOUCH, FpDevice);
 G_DEFINE_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch, FP_TYPE_DEVICE);
 
-enum { SEND_COMMAND, RECEIVE_REPLY, RECEIVE_FRAMES, PROCESS_FRAMES, N_STATES };
+enum { SEND_COMMAND, RECEIVE_REPLY, RECEIVE_FRAMES, PROCESS_FRAMES, MATCH_FRAMES, N_STATES };
+
+/* Owned by a GTask. Templates are immutable snapshots; only the main thread
+ * accesses FpPrint objects or reports results to libfprint. */
+typedef struct
+{
+  FpiDeviceAction action;
+  GPtrArray *templates;
+  GBytes *enrollment;
+} MatchData;
+
+static void
+match_data_free (MatchData *data)
+{
+  g_ptr_array_unref (data->templates);
+  g_clear_pointer (&data->enrollment, g_bytes_unref);
+  g_free (data);
+}
 
 static guint
-compare_print (Egis0570TouchFeatures *probe, FpPrint *print, gboolean stop_on_match)
+compare_print (Egis0570TouchFeatures *probe, GVariant *data, gboolean stop_on_match,
+               GCancellable *cancellable)
 {
-  g_autoptr(GVariant) data = NULL;
   g_autoptr(GVariant) samples = NULL;
   guint version;
   guint best = 0;
-  g_object_get (print, "fpi-data", &data, NULL);
   if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uaay)")))
     return 0;
   g_variant_get (data, "(u@aay)", &version, &samples);
@@ -52,13 +72,16 @@ compare_print (Egis0570TouchFeatures *probe, FpPrint *print, gboolean stop_on_ma
     return 0;
   for (gsize i = 0; i < g_variant_n_children (samples); i++)
     {
+      if (g_cancellable_is_cancelled (cancellable))
+        break;
       g_autoptr(GVariant) sample = g_variant_get_child_value (samples, i);
       gsize size;
       const guint8 *bytes = g_variant_get_fixed_array (sample, &size, 1);
       g_autoptr(GBytes) blob = g_bytes_new (bytes, size);
       g_autoptr(Egis0570TouchFeatures) gallery = fpi_egis0570touch_features_deserialise (blob);
-      guint score = MIN (fpi_egis0570touch_features_compare (probe, gallery),
-                         fpi_egis0570touch_features_compare (gallery, probe));
+      guint forward = fpi_egis0570touch_features_compare (probe, gallery);
+      guint reverse = fpi_egis0570touch_features_compare (gallery, probe);
+      guint score = MIN (forward, reverse);
       fp_dbg ("Sample %zu score %u (experimental threshold %u)", i, score, MATCH_THRESHOLD);
       best = MAX (best, score);
       if (stop_on_match && best >= MATCH_THRESHOLD)
@@ -67,24 +90,12 @@ compare_print (Egis0570TouchFeatures *probe, FpPrint *print, gboolean stop_on_ma
   return best;
 }
 
-static guint
-compare_press (GPtrArray *probes, FpPrint *print, gboolean stop_on_match)
-{
-  guint best = 0;
-  for (guint i = 0; i < probes->len; i++)
-    {
-      best = MAX (best, compare_print (g_ptr_array_index (probes, i), print, stop_on_match));
-      if (stop_on_match && best >= MATCH_THRESHOLD)
-        break;
-    }
-  return best;
-}
-
 static void
 report_retry (FpDevice *dev)
 {
-  GError *error = fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
   FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  GError *error = fpi_device_retry_new (self->present ? FP_DEVICE_RETRY_REMOVE_FINGER :
+                                      FP_DEVICE_RETRY_GENERAL);
   switch ((gint) fpi_device_get_current_action (dev))
     {
     case FPI_DEVICE_ACTION_ENROLL:
@@ -105,87 +116,105 @@ report_retry (FpDevice *dev)
 }
 
 static void
-process_press (FpDevice *dev)
+match_frames (GTask *task, gpointer source_object, gpointer task_data,
+              GCancellable *cancellable)
 {
-  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
-  g_autoptr(GPtrArray) probes = g_ptr_array_new_with_free_func (
-    (GDestroyNotify) fpi_egis0570touch_features_free);
-  Egis0570TouchFeatures *features = NULL;
-  if (self->frame_count >= 10)
+  FpDeviceEgis0570Touch *self = source_object;
+  MatchData *data = task_data;
+  g_autoptr(Egis0570TouchFeatures) features = NULL;
+  gint winner = -1;
+  guint best = MATCH_THRESHOLD - 1;
+
+  /* The USB state machine is paused until this task finishes. */
+  if (g_task_return_error_if_cancelled (task))
+    return;
+  if (self->frame_count >= AUTH_FRAMES)
+    features = fpi_egis0570touch_features_extract (self->frames, self->frame_count,
+                                                 self->background);
+  if (fpi_egis0570touch_features_keypoint_count (features) < MIN_FEATURES)
     {
-      guint group_size = fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_ENROLL
-                         ? MAX_FRAMES : 10;
-      for (guint offset = 0; offset < self->frame_count; offset += group_size)
+      g_task_return_error (task, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      return;
+    }
+  if (data->action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      data->enrollment = fpi_egis0570touch_features_serialise (features);
+      if (!data->enrollment)
         {
-          Egis0570TouchFeatures *candidate = fpi_egis0570touch_features_extract (
-            self->frames + offset * FRAME_PIXELS,
-            MIN (group_size, self->frame_count - offset), self->background);
-          if (!candidate)
-            continue;
-          g_ptr_array_add (probes, candidate);
-          if (!features || fpi_egis0570touch_features_keypoint_count (candidate) >
-                           fpi_egis0570touch_features_keypoint_count (features))
-            features = candidate;
+          g_task_return_error (task, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+          return;
         }
     }
-  fp_dbg ("Press: %u frames, %u descriptors", self->frame_count,
-           fpi_egis0570touch_features_keypoint_count (features));
-  if (!features || fpi_egis0570touch_features_keypoint_count (features) < 20)
+  for (guint i = 0; i < data->templates->len; i++)
+    {
+      if (g_task_return_error_if_cancelled (task))
+        return;
+      guint score = compare_print (features, g_ptr_array_index (data->templates, i),
+                                   data->action == FPI_DEVICE_ACTION_VERIFY, cancellable);
+      if (score > best)
+        {
+          best = score;
+          winner = i;
+        }
+    }
+  g_task_return_int (task, winner);
+}
+
+static void
+match_done (GObject *source_object, GAsyncResult *result, gpointer unused)
+{
+  FpDevice *dev = FP_DEVICE (source_object);
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  MatchData *data = g_task_get_task_data (G_TASK (result));
+  g_autoptr(GError) error = NULL;
+  gint winner = g_task_propagate_int (G_TASK (result), &error);
+
+  if (error)
     {
+      if (error->domain != FP_DEVICE_RETRY)
+        {
+          fpi_ssm_mark_failed (self->ssm, g_steal_pointer (&error));
+          return;
+        }
       report_retry (dev);
-      return;
     }
-  switch ((gint) fpi_device_get_current_action (dev))
+  else switch ((gint) data->action)
     {
     case FPI_DEVICE_ACTION_ENROLL:
-      {
-        GBytes *blob = fpi_egis0570touch_features_serialise (features);
-        if (!blob)
-          {
-            report_retry (dev);
-            return;
-          }
-        g_ptr_array_add (self->blobs, blob);
-        fpi_device_enroll_progress (dev, self->blobs->len, NULL, NULL);
-        self->finished = self->blobs->len == ENROLL_STAGES;
-        break;
-      }
+      g_ptr_array_add (self->blobs, g_steal_pointer (&data->enrollment));
+      fpi_device_enroll_progress (dev, self->blobs->len, NULL, NULL);
+      self->finished = self->blobs->len == ENROLL_STAGES;
+      break;
     case FPI_DEVICE_ACTION_VERIFY:
-      {
-        FpPrint *print;
-        fpi_device_get_verify_data (dev, &print);
-        gboolean match = compare_press (probes, print, TRUE) >= MATCH_THRESHOLD;
-        fpi_device_verify_report (dev, match ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
-                                  NULL, NULL);
-        self->finished = TRUE;
-        break;
-      }
+      fpi_device_verify_report (dev, winner >= 0 ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                NULL, NULL);
+      self->finished = TRUE;
+      break;
     case FPI_DEVICE_ACTION_IDENTIFY:
       {
         GPtrArray *prints;
-        FpPrint *winner = NULL;
-        guint best = MATCH_THRESHOLD - 1;
         fpi_device_get_identify_data (dev, &prints);
-        for (guint i = 0; i < prints->len; i++)
-          {
-            FpPrint *print = g_ptr_array_index (prints, i);
-            guint score = compare_press (probes, print, FALSE);
-            if (score > best)
-              {
-                best = score;
-                winner = print;
-              }
-          }
-        fpi_device_identify_report (dev, winner, NULL, NULL);
+        fpi_device_identify_report (dev, winner >= 0 ? g_ptr_array_index (prints, winner) : NULL,
+                                    NULL, NULL);
         self->finished = TRUE;
         break;
       }
     default:
       g_assert_not_reached ();
     }
+  self->frame_count = 0;
+  if (self->finished)
+    fpi_ssm_mark_completed (self->ssm);
+  else
+    {
+      fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+      self->initializing = FALSE;
+      self->command = 0;
+      fpi_ssm_jump_to_state (self->ssm, SEND_COMMAND);
+    }
 }
 
-static void
+static gboolean
 process_packet (FpDevice *dev)
 {
   FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
@@ -199,7 +228,7 @@ process_packet (FpDevice *dev)
         }
       self->calibrated = TRUE;
       fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
-      return;
+      return FALSE;
     }
   for (guint k = 0; k < EGIS0570_IMGCOUNT && !self->finished; k++)
     {
@@ -208,6 +237,19 @@ process_packet (FpDevice *dev)
       for (guint i = 20 * EGIS0570_IMGWIDTH; i < 37 * EGIS0570_IMGWIDTH; i++)
         mean += MAX (0, (int) frame[i] - self->background[i]);
       mean /= 17 * EGIS0570_IMGWIDTH;
+      /* Do not treat one held finger as several operations after a retry. */
+      if (self->wait_for_removal)
