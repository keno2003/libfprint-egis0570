+ */
+
+#ifndef __EGIS0570TOUCH_PROTO_H
+
+#define __EGIS0570TOUCH_PROTO_H 1
+
+/*
+ * Device data
+ */
+
+#define EGIS0570_CONF 1
+#define EGIS0570_INTF 0
+
+/*
+ * Device endpoints
+ */
+
+#define EGIS0570_EPOUT 0x04 /* ( 4 | FPI_USB_ENDPOINT_OUT ) */
+#define EGIS0570_EPIN 0x83  /* ( 3 | FPI_USB_ENDPOINT_IN ) */
+
+/*
+ * Initialization packets (7 bytes each)
+ *
+ * First 4 bytes are equivalent to string "EGIS", which must be just a company identificator
+ * Other 3 bytes are not recognized yet and may be not important, as they are always the same
+
+ * Answers for each packet contain 7 bytes again
+ * First 4 bytes are reversed "EGIS", which is "SIGE", which is company ID again
+ * Other 3 bytes are not recognized yet
+ * But there is a pattern.
+ * Sending last packet makes sensor return image
+ */
+
+#define EGIS0570_TIMEOUT 10000
+#define EGIS0570_PKTSIZE 7
+
+#define EGIS0570_INIT_TOTAL (sizeof ((init_pkts)) / sizeof ((init_pkts[0])))
+
+static unsigned char init_pkts[][EGIS0570_PKTSIZE] = {
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x10, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x11, 0x38},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x12, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x13, 0x71},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x20, 0x3f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x58, 0x3f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x21, 0x07},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x57, 0x07},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x22, 0x02},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x56, 0x02},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x23, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x55, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x24, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x54, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x25, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x53, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x15, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x16, 0x3b},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x09, 0x0a},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x14, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x0f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x03, 0x80},
+	{0x45, 0x47, 0x49, 0x53, 0x00, 0x02, 0x80},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x2f},
+	{0x45, 0x47, 0x49, 0x53, 0x06, 0x00, 0xfe}
+};
+
+/*
+ * After sending initial packets device returns image data (32512 bytes)
+ * To ask device to send image data again, host needs to send four additional packets
+ * Further work is to repeatedly send four repeat packets and read image data
+ */
+
+#define EGIS0570_INPSIZE 32512
+
+/* 5 image with captured in different time of size 114 * 57 = 6498
+ * 5 * 6498 = 32490 plus 22 extra unrecognized char size data
+ * Two continuous image in this 5 images may have time delay of less than 20ms
+ */
+
+#define EGIS0570_IMGSIZE 6498
+#define EGIS0570_IMGWIDTH 114
+#define EGIS0570_IMGHEIGHT 57
+
+#define EGIS0570_IMGCOUNT 5
+
+/*
+ * Image repeat request
+ * First 4 bytes are the same as in initialization packets
+ * Have no idea what the other 3 bytes mean
+ */
+
+#define EGIS0570_REPEAT_TOTAL (sizeof ((repeat_pkts)) / sizeof ((repeat_pkts[0])))
+
+static unsigned char repeat_pkts[][EGIS0570_PKTSIZE] =
+{
+  { 0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x0f },
+  { 0x45, 0x47, 0x49, 0x53, 0x00, 0x02, 0x0f },
+  { 0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x2f },
+  { 0x45, 0x47, 0x49, 0x53, 0x06, 0x00, 0xfe }         /* image returned after this packet */
+};
+
+/* Minimum foreground signal for finger presence detection. */
+#define EGIS0570_MIN_MEAN 20
+
+#endif
diff --git a/libfprint/drivers/egis0570touch.c b/libfprint/drivers/egis0570touch.c
new file mode 100644
index 00000000..4a601336
--- /dev/null
+++ b/libfprint/drivers/egis0570touch.c
@@ -0,0 +1,437 @@
+/*
+ * Egis 0570 press driver. LGPL-2.1-or-later.
+ * USB protocol and initialization derived from the existing egis0570 driver
+ * by Maxim Kolesnikov and Saeed/Ali Rk, and the Acer Swift 1 patch.
+ */
+#define FP_COMPONENT "egis0570"
+#include "drivers_api.h"
+#include "egis0570touch-proto.h"
+#include "egis0570touch-match.h"
+
+#define FRAME_PIXELS (EGIS0570_IMGWIDTH * EGIS0570_IMGHEIGHT)
+#define MAX_FRAMES 50
+#define ENROLL_STAGES 12
+/* Provisional research threshold, not a measured false-accept guarantee. */
+#define MATCH_THRESHOLD 12
+
+struct _FpDeviceEgis0570Touch
+{
+  FpDevice parent;
+  FpiSsm *ssm;
+  guint command;
+  gboolean initializing;
+  gboolean calibrated;
+  gboolean present;
+  guint absent_frames;
+  guint frame_count;
+  guint16 background[FRAME_PIXELS];
+  guint16 *frames;
+  double scores[MAX_FRAMES];
+  guint8 packet[EGIS0570_INPSIZE];
+  GPtrArray *blobs;
+  gboolean finished;
+};
+G_DECLARE_FINAL_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch,
+                      FPI, DEVICE_EGIS0570TOUCH, FpDevice);
+G_DEFINE_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch, FP_TYPE_DEVICE);
+
+enum { SEND_COMMAND, RECEIVE_REPLY, RECEIVE_FRAMES, PROCESS_FRAMES, N_STATES };
+
+static guint
+compare_print (Egis0570TouchFeatures *probe, FpPrint *print)
+{
+  g_autoptr(GVariant) data = NULL;
+  g_autoptr(GVariant) samples = NULL;
+  guint version;
+  guint best = 0;
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uaay)")))
+    return 0;
+  g_variant_get (data, "(u@aay)", &version, &samples);
+  if (version != 1 || g_variant_n_children (samples) != ENROLL_STAGES)
+    return 0;
+  for (gsize i = 0; i < g_variant_n_children (samples); i++)
+    {
+      g_autoptr(GVariant) sample = g_variant_get_child_value (samples, i);
+      gsize size;
+      const guint8 *bytes = g_variant_get_fixed_array (sample, &size, 1);
+      g_autoptr(GBytes) blob = g_bytes_new (bytes, size);
+      g_autoptr(Egis0570TouchFeatures) gallery = fpi_egis0570touch_features_deserialise (blob);
+      guint score = MIN (fpi_egis0570touch_features_compare (probe, gallery),
+                         fpi_egis0570touch_features_compare (gallery, probe));
+      fp_dbg ("Sample %zu score %u (experimental threshold %u)", i, score, MATCH_THRESHOLD);
+      best = MAX (best, score);
+    }
+  return best;
+}
+
+static guint
+compare_press (GPtrArray *probes, FpPrint *print)
+{
+  guint best = 0;
+  for (guint i = 0; i < probes->len; i++)
+    best = MAX (best, compare_print (g_ptr_array_index (probes, i), print));
+  return best;
+}
+
+static void
+report_retry (FpDevice *dev)
+{
+  GError *error = fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  switch ((gint) fpi_device_get_current_action (dev))
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      fpi_device_enroll_progress (dev, self->blobs->len, NULL, error);
+      break;
+    case FPI_DEVICE_ACTION_VERIFY:
+      fpi_device_verify_report (dev, FPI_MATCH_ERROR, NULL, error);
+      self->finished = TRUE;
+      break;
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      fpi_device_identify_report (dev, NULL, NULL, error);
+      self->finished = TRUE;
+      break;
+    default:
+      g_error_free (error);
+      g_assert_not_reached ();
+    }
+}
+
+static void
+process_press (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  g_autoptr(GPtrArray) probes = g_ptr_array_new_with_free_func (
+    (GDestroyNotify) fpi_egis0570touch_features_free);
+  Egis0570TouchFeatures *features = NULL;
+  if (self->frame_count >= 10)
+    {
+      guint group_size = fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_ENROLL
+                         ? MAX_FRAMES : 10;
+      for (guint offset = 0; offset < self->frame_count; offset += group_size)
+        {
+          Egis0570TouchFeatures *candidate = fpi_egis0570touch_features_extract (
+            self->frames + offset * FRAME_PIXELS,
+            MIN (group_size, self->frame_count - offset), self->background);
+          if (!candidate)
+            continue;
+          g_ptr_array_add (probes, candidate);
+          if (!features || fpi_egis0570touch_features_keypoint_count (candidate) >
+                           fpi_egis0570touch_features_keypoint_count (features))
+            features = candidate;
+        }
+    }
+  fp_dbg ("Press: %u frames, %u descriptors", self->frame_count,
+           fpi_egis0570touch_features_keypoint_count (features));
+  if (!features || fpi_egis0570touch_features_keypoint_count (features) < 20)
+    {
+      report_retry (dev);
+      return;
+    }
+  switch ((gint) fpi_device_get_current_action (dev))
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      {
+        GBytes *blob = fpi_egis0570touch_features_serialise (features);
+        if (!blob)
+          {
+            report_retry (dev);
+            return;
+          }
+        g_ptr_array_add (self->blobs, blob);
+        fpi_device_enroll_progress (dev, self->blobs->len, NULL, NULL);
+        self->finished = self->blobs->len == ENROLL_STAGES;
+        break;
+      }
+    case FPI_DEVICE_ACTION_VERIFY:
+      {
+        FpPrint *print;
+        fpi_device_get_verify_data (dev, &print);
+        gboolean match = compare_press (probes, print) >= MATCH_THRESHOLD;
+        fpi_device_verify_report (dev, match ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                  NULL, NULL);
+        self->finished = TRUE;
+        break;
+      }
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      {
+        GPtrArray *prints;
+        FpPrint *winner = NULL;
+        guint best = MATCH_THRESHOLD - 1;
+        fpi_device_get_identify_data (dev, &prints);
+        for (guint i = 0; i < prints->len; i++)
+          {
+            FpPrint *print = g_ptr_array_index (prints, i);
+            guint score = compare_press (probes, print);
+            if (score > best)
+              {
+                best = score;
+                winner = print;
+              }
+          }
+        fpi_device_identify_report (dev, winner, NULL, NULL);
+        self->finished = TRUE;
+        break;
+      }
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+process_packet (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  if (!self->calibrated)
+    {
+      for (guint i = 0; i < FRAME_PIXELS; i++)
+        {
+          self->background[i] = 255;
+          for (guint k = 0; k < EGIS0570_IMGCOUNT; k++)
+            self->background[i] = MIN (self->background[i], self->packet[k * FRAME_PIXELS + i]);
+        }
+      self->calibrated = TRUE;
+      fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+      return;
+    }
+  for (guint k = 0; k < EGIS0570_IMGCOUNT && !self->finished; k++)
+    {
+      const guint8 *frame = self->packet + k * FRAME_PIXELS;
+      double mean = 0;
+      for (guint i = 20 * EGIS0570_IMGWIDTH; i < 37 * EGIS0570_IMGWIDTH; i++)
+        mean += MAX (0, (int) frame[i] - self->background[i]);
+      mean /= 17 * EGIS0570_IMGWIDTH;
+      if (mean > EGIS0570_MIN_MEAN)
+        {
+          self->absent_frames = 0;
+          if (!self->present)
+            {
+              self->present = TRUE;
+              fpi_device_report_finger_status (dev, FP_FINGER_STATUS_PRESENT);
+            }
+          guint slot = self->frame_count;
+          if (slot == MAX_FRAMES)
+            {
+              slot = 0;
+              for (guint i = 1; i < MAX_FRAMES; i++)
+                if (self->scores[i] < self->scores[slot])
+                  slot = i;
+              if (mean <= self->scores[slot])
+                continue;
+            }
+          else
+            self->frame_count++;
+          self->scores[slot] = mean;
+          for (guint i = 0; i < FRAME_PIXELS; i++)
+            self->frames[slot * FRAME_PIXELS + i] = frame[i];
+        }
+      else if (self->present && ++self->absent_frames >= 5)
+        {
+          self->present = FALSE;
+          fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NONE);
+          process_press (dev);
+          self->frame_count = 0;
+          if (!self->finished)
+            fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+        }
+    }
+}
+
+static void
+receive_frames_cb (FpiUsbTransfer *transfer, FpDevice *dev, gpointer unused, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  memcpy (self->packet, transfer->buffer, sizeof (self->packet));
+  fpi_ssm_next_state (transfer->ssm);
+}
+
+static void
+run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  FpiUsbTransfer *transfer;
+  guint total = self->initializing ? EGIS0570_INIT_TOTAL : EGIS0570_REPEAT_TOTAL;
+  /* Drain each complete request/response cycle before honoring cancellation. */
+  if ((fpi_ssm_get_cur_state (ssm) == PROCESS_FRAMES ||
+       (fpi_ssm_get_cur_state (ssm) == SEND_COMMAND && self->command == 0)) &&
+      fpi_device_action_is_cancelled (dev))
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED, "Cancelled"));
+      return;
+    }
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case SEND_COMMAND:
+      transfer = fpi_usb_transfer_new (dev);
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPOUT, EGIS0570_PKTSIZE);
+      memcpy (transfer->buffer, self->initializing ? init_pkts[self->command] : repeat_pkts[self->command], EGIS0570_PKTSIZE);
+      fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, fpi_ssm_usb_transfer_cb, NULL);
+      break;
+    case RECEIVE_REPLY:
+      if (self->command == total - 1)
+        fpi_ssm_next_state (ssm);
+      else
+        {
+          transfer = fpi_usb_transfer_new (dev);
+          transfer->ssm = ssm;
+          transfer->short_is_error = TRUE;
+          fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPIN, EGIS0570_PKTSIZE);
+          fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, fpi_ssm_usb_transfer_cb, NULL);
+        }
+      break;
+    case RECEIVE_FRAMES:
+      if (self->command < total - 1)
+        {
+          self->command++;
+          fpi_ssm_jump_to_state (ssm, SEND_COMMAND);
+          break;
+        }
+      transfer = fpi_usb_transfer_new (dev);
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPIN, EGIS0570_INPSIZE);
+      fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, receive_frames_cb, NULL);
+      break;
+    case PROCESS_FRAMES:
+      process_packet (dev);
+      if (self->finished)
+        fpi_ssm_mark_completed (ssm);
+      else
+        {
+          self->initializing = FALSE;
+          self->command = 0;
+          fpi_ssm_jump_to_state (ssm, SEND_COMMAND);
+        }
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+operation_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  self->ssm = NULL;
+  fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NONE);
+  if (error)
+    {
+      fpi_device_action_error (dev, error);
+      return;
+    }
+  switch ((gint) fpi_device_get_current_action (dev))
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      {
+        FpPrint *print;
+        GVariantBuilder builder;
+        fpi_device_get_enroll_data (dev, &print);
+        g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+        for (guint i = 0; i < self->blobs->len; i++)
+          {
+            gsize size;
+            const void *data = g_bytes_get_data (g_ptr_array_index (self->blobs, i), &size);
+            g_variant_builder_add_value (&builder, g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, data, size, 1));
+          }
+        fpi_print_set_type (print, FPI_PRINT_RAW);
+        fpi_print_set_device_stored (print, FALSE);
+        g_object_set (print, "fpi-data", g_variant_new ("(uaay)", 1u, &builder), NULL);
+        fpi_device_enroll_complete (dev, g_object_ref (print), NULL);
+        break;
+      }
+    case FPI_DEVICE_ACTION_VERIFY:
+      fpi_device_verify_complete (dev, NULL);
+      break;
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      fpi_device_identify_complete (dev, NULL);
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+start_operation (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  self->command = 0;
+  self->initializing = TRUE;
+  self->present = FALSE;
+  self->finished = FALSE;
+  self->absent_frames = 0;
+  self->frame_count = 0;
+  g_ptr_array_set_size (self->blobs, 0);
+  self->ssm = fpi_ssm_new (dev, run_state, N_STATES);
+  fpi_ssm_start (self->ssm, operation_complete);
+}
+
+static void
+dev_open (FpDevice *dev)
+{
+  GError *error = NULL;
+  /* Keep the empty-sensor reference across operations on one open device.
+   * Recalibrating after every verification can mistake the next touch for
+   * background when the user presents their finger before capture starts. */
+  FPI_DEVICE_EGIS0570TOUCH (dev)->calibrated = FALSE;
+  g_usb_device_claim_interface (fpi_device_get_usb_device (dev), 0, 0, &error);
+  fpi_device_open_complete (dev, error);
+}
+
+static void
+dev_close (FpDevice *dev)
+{
+  GError *error = NULL;
+  g_usb_device_release_interface (fpi_device_get_usb_device (dev), 0, 0, &error);
+  fpi_device_close_complete (dev, error);
+}
+
+static void
+finalize (GObject *object)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (object);
+  g_free (self->frames);
+  g_ptr_array_unref (self->blobs);
+  G_OBJECT_CLASS (fpi_device_egis0570touch_parent_class)->finalize (object);
+}
+
+static const FpIdEntry id_table[] = {
+  { .vid = 0x1c7a, .pid = 0x0570 },
+  { .vid = 0, .pid = 0 }
+};
+
+static void
+fpi_device_egis0570touch_init (FpDeviceEgis0570Touch *self)
+{
+  self->frames = g_new (guint16, MAX_FRAMES * FRAME_PIXELS);
+  self->blobs = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+}
+
+static void
+fpi_device_egis0570touch_class_init (FpDeviceEgis0570TouchClass *klass)
+{
+  FpDeviceClass *dev = FP_DEVICE_CLASS (klass);
+  G_OBJECT_CLASS (klass)->finalize = finalize;
+  /* Preserve the existing driver identity so fprintd selects this as the
+   * replacement implementation for 1c7a:0570. Old image templates fail the
+   * raw-template type check above and must be enrolled again. */
+  dev->id = "egis0570";
+  dev->full_name = "Egis Technology Inc. 0570 touch sensor";
+  dev->type = FP_DEVICE_TYPE_USB;
+  dev->id_table = id_table;
+  dev->scan_type = FP_SCAN_TYPE_PRESS;
+  dev->nr_enroll_stages = ENROLL_STAGES;
+  dev->open = dev_open;
+  dev->close = dev_close;
+  dev->enroll = start_operation;
+  dev->verify = start_operation;
+  dev->identify = start_operation;
+  fpi_device_class_auto_initialize_features (dev);
+}
